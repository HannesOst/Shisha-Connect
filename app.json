{
  "expo": {
    "name": "Shisha Connect",
    "slug": "shisha-connect",
    "scheme": "shishaconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141517",
    "ios": {
      "bundleIdentifier": "ch.shishaconnect.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ch.shishaconnect.app",
      "adaptiveIcon": {
        "backgroundColor": "#141517",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#141517"
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#F2541B",
          "defaultChannel": "meetups"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shisha Connect nutzt deinen Standort nur, um Shisha-Bars in deiner Nähe zu finden.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Shisha Connect braucht Zugriff auf deine Fotos, damit du ein Profilbild wählen kannst.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
